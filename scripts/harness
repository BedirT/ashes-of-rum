#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UNITY_CLI="${UNITY_CLI:-$HOME/.unity/bin/unity}"
EDITOR_VERSION="$(awk '/^m_EditorVersion:/{print $2; exit}' "$ROOT/ProjectSettings/ProjectVersion.txt")"
SHA="$(git -C "$ROOT" rev-parse HEAD)"
EVIDENCE="$ROOT/.artifacts/verification/$SHA"
BUILD_APP="$EVIDENCE/Ashes of Rum.app"
SMOKE_RESULT="$EVIDENCE/smoke-result.json"
PLAYER_LOG="$EVIDENCE/player.log"
GRAPHICAL_RESULT="$EVIDENCE/graphical-smoke-result.json"
GRAPHICAL_LOG="$EVIDENCE/graphical-player.log"
GRAPHICAL_SCREENSHOT="$EVIDENCE/graphical-smoke.png"
GRAPHICAL_HEALTH_SCREENSHOT="$EVIDENCE/graphical-health-bars.png"
AGENT_SCRIPT="$ROOT/scripts/fixtures/agent-starting-economy.json"
AGENT_HEADLESS_DIR="$EVIDENCE/agent-headless"
AGENT_GRAPHICAL_DIR="$EVIDENCE/agent-graphical"
AGENT_HEADLESS_RESULT="$AGENT_HEADLESS_DIR/result.json"
AGENT_GRAPHICAL_RESULT="$AGENT_GRAPHICAL_DIR/result.json"
AGENT_GRAPHICAL_SCREENSHOT="$AGENT_GRAPHICAL_DIR/gather-deposit.png"
HOUSE_AGENT_SCRIPT="$ROOT/scripts/fixtures/agent-house-construction.json"
HOUSE_AGENT_HEADLESS_DIR="$EVIDENCE/agent-house-headless"
HOUSE_AGENT_GRAPHICAL_DIR="$EVIDENCE/agent-house-graphical"
HOUSE_AGENT_HEADLESS_RESULT="$HOUSE_AGENT_HEADLESS_DIR/result.json"
HOUSE_AGENT_GRAPHICAL_RESULT="$HOUSE_AGENT_GRAPHICAL_DIR/result.json"
HOUSE_AGENT_GRAPHICAL_SCREENSHOT="$HOUSE_AGENT_GRAPHICAL_DIR/house-complete.png"
TRAINING_AGENT_SCRIPT="$ROOT/scripts/fixtures/agent-formation-training.json"
TRAINING_AGENT_HEADLESS_DIR="$EVIDENCE/agent-training-headless"
TRAINING_AGENT_GRAPHICAL_DIR="$EVIDENCE/agent-training-graphical"
TRAINING_AGENT_HEADLESS_RESULT="$TRAINING_AGENT_HEADLESS_DIR/result.json"
TRAINING_AGENT_GRAPHICAL_RESULT="$TRAINING_AGENT_GRAPHICAL_DIR/result.json"
TRAINING_AGENT_GRAPHICAL_SCREENSHOT="$TRAINING_AGENT_GRAPHICAL_DIR/spearmen-ready.png"
MOVEMENT_AGENT_SCRIPT="$ROOT/scripts/fixtures/agent-formation-movement.json"
MOVEMENT_AGENT_HEADLESS_DIR="$EVIDENCE/agent-movement-headless"
MOVEMENT_AGENT_GRAPHICAL_DIR="$EVIDENCE/agent-movement-graphical"
MOVEMENT_AGENT_HEADLESS_RESULT="$MOVEMENT_AGENT_HEADLESS_DIR/result.json"
MOVEMENT_AGENT_GRAPHICAL_RESULT="$MOVEMENT_AGENT_GRAPHICAL_DIR/result.json"
MOVEMENT_AGENT_GRAPHICAL_SCREENSHOT="$MOVEMENT_AGENT_GRAPHICAL_DIR/spearmen-moved.png"
COMBAT_AGENT_SCRIPT="$ROOT/scripts/fixtures/agent-formation-combat.json"
COMBAT_AGENT_HEADLESS_DIR="$EVIDENCE/agent-combat-headless"
COMBAT_AGENT_GRAPHICAL_DIR="$EVIDENCE/agent-combat-graphical"
COMBAT_AGENT_HEADLESS_RESULT="$COMBAT_AGENT_HEADLESS_DIR/result.json"
COMBAT_AGENT_GRAPHICAL_RESULT="$COMBAT_AGENT_GRAPHICAL_DIR/result.json"
COMBAT_AGENT_GRAPHICAL_SCREENSHOT="$COMBAT_AGENT_GRAPHICAL_DIR/spearmen-focus-worker.png"
ECONOMY_AGENT_SCRIPT="$ROOT/scripts/fixtures/agent-economy-production.json"
ECONOMY_AGENT_HEADLESS_DIR="$EVIDENCE/agent-economy-headless"
ECONOMY_AGENT_GRAPHICAL_DIR="$EVIDENCE/agent-economy-graphical"
ECONOMY_AGENT_HEADLESS_RESULT="$ECONOMY_AGENT_HEADLESS_DIR/result.json"
ECONOMY_AGENT_GRAPHICAL_RESULT="$ECONOMY_AGENT_GRAPHICAL_DIR/result.json"
ECONOMY_AGENT_GRAPHICAL_SCREENSHOT="$ECONOMY_AGENT_GRAPHICAL_DIR/economy-production-complete.png"
PLAYER_TIMEOUT_SECONDS="${PLAYER_TIMEOUT_SECONDS:-90}"
GRAPHICAL_PLAYER_TIMEOUT_SECONDS="${GRAPHICAL_PLAYER_TIMEOUT_SECONDS:-120}"

export UNITY_NO_CONSENT_PROMPT=1
export UNITY_NO_UPDATE_CHECK=1

say() { printf '[harness] %s\n' "$*"; }
fail() { printf '[harness] ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "Missing required command: $1"; }
unity_cli() { "$UNITY_CLI" --no-banner --non-interactive "$@"; }

doctor() {
  need git
  need jq
  need file
  [[ -x "$UNITY_CLI" ]] || fail "Unity CLI not found at $UNITY_CLI"
  [[ -f "$ROOT/Assets/Scenes/Bootstrap.unity" ]] || fail "Bootstrap scene is missing; run make bootstrap"
  [[ -f "$ROOT/Packages/manifest.json" ]] || fail "Unity package manifest is missing"
  unity_cli --version
  unity_cli auth status
  unity_cli license status
  unity_cli editors list --installed | grep -F "$EDITOR_VERSION" >/dev/null || fail "Unity Editor $EDITOR_VERSION is not installed"
  if pgrep -f "Unity.*-projectPath $ROOT" >/dev/null 2>&1; then
    fail "A Unity process already has this project open"
  fi
  say "Doctor passed for Unity $EDITOR_VERSION."
}

bootstrap() {
  unity_cli run "$ROOT" --timeout 300 -- \
    -executeMethod AshesOfRum.Editor.BootstrapProject.Generate \
    -logFile "$ROOT/Logs/bootstrap.log"
}

import_project() {
  unity_cli run "$ROOT" --timeout 300 -- -logFile "$ROOT/Logs/import.log"
}

run_tests() {
  local output_dir="$1"
  mkdir -p "$output_dir"
  unity_cli test "$ROOT" --mode EditMode --output "$output_dir/editmode.xml" --timeout 420
  unity_cli test "$ROOT" --mode PlayMode --output "$output_dir/playmode.xml" --timeout 420
}

verify_fast() {
  doctor
  import_project
  run_tests "$ROOT/.artifacts/verification/working-tree"
  scan_log "$ROOT/Logs/import.log"
  say "Fast verification passed."
}

scan_log() {
  local log="$1"
  local severity_lines unexpected_severity licensing_failure_line licensing_recovery_line
  [[ -f "$log" ]] || fail "Expected log not found: $log"
  if grep -E "(^|[^A-Za-z])(NullReferenceException|MissingReferenceException|Assertion failed|Crash!!!|Scripts have compiler errors|Compilation failed|Player build failed)([^A-Za-z]|$)" "$log" >/dev/null; then
    fail "Runtime or compiler failure found in $log"
  fi
  severity_lines="$(grep -E '(^|\]) (Error:|Failed( |$))' "$log" || true)"
  unexpected_severity="$(printf '%s\n' "$severity_lines" \
    | grep -Fv '[Licensing::Client] Error: HandshakeResponse reported an error:' \
    | grep -Fv '[Licensing::Module] Error: Failed to handshake to channel:' \
    | grep -Fv '[Licensing::Module] Error: Licensing initialization failed after' \
    | grep -Fv '[Licensing::Module] Error: The connection with the Unity Licensing Client has been lost. Attempting to reconnect.' || true)"
  [[ -z "$unexpected_severity" ]] || fail "Unexpected error-severity log entry in $log: $unexpected_severity"
  licensing_failure_line="$(grep -nE '(HandshakeResponse reported an error:|Failed to handshake to channel:|Licensing initialization failed after|connection with the Unity Licensing Client has been lost)' "$log" \
    | tail -n 1 | cut -d: -f1 || true)"
  if [[ -n "$licensing_failure_line" ]]; then
    # Unity can first contact an older shared LicensingClient, then relaunch its versioned client.
    licensing_recovery_line="$(grep -nF '[Licensing::Module] Successfully connected to LicensingClient on channel:' "$log" \
      | tail -n 1 | cut -d: -f1 || true)"
    [[ -n "$licensing_recovery_line" && "$licensing_recovery_line" -gt "$licensing_failure_line" ]] \
      || fail "Licensing fallback did not reconnect after the final failure in $log"
  fi
}

scan_log_self_test() {
  local fixture_dir
  fixture_dir="$(mktemp -d)"
  printf '%s\n' \
    '[Licensing::Module] Successfully connected to LicensingClient on channel: initial' \
    '[Licensing::Module] Error: The connection with the Unity Licensing Client has been lost. Attempting to reconnect.' \
    > "$fixture_dir/unrecovered.log"
  if (scan_log "$fixture_dir/unrecovered.log") >"$fixture_dir/unrecovered-result.log" 2>&1; then
    fail "Licensing success-before-failure fixture unexpectedly passed"
  fi
  grep -F 'did not reconnect after the final failure' "$fixture_dir/unrecovered-result.log" >/dev/null \
    || fail "Licensing failure fixture did not report the expected order-sensitive error"

  printf '%s\n' \
    '[Licensing::Module] Error: Failed to handshake to channel: initial' \
    '[Licensing::Module] Successfully connected to LicensingClient on channel: recovered' \
    > "$fixture_dir/recovered.log"
  scan_log "$fixture_dir/recovered.log"
  rm -rf "$fixture_dir"
}

validate_json() {
  local json_file="$1"
  jq -e . "$json_file" >/dev/null || fail "Invalid JSON: $json_file"
}

validate_agent_checkpoint_contract() {
  local result="$1"
  local output="$2"
  local manifest="$3"
  local state="$4"
  jq -e --arg manifest "$manifest" '.checkpointManifests == [$manifest]' "$result" >/dev/null \
    || fail "Agent result does not identify the exact checkpoint manifest: $result"
  jq -e --slurpfile saved "$state" --arg state "$state" \
    '.statePath == $state and .stateHash == $saved[0].stateHash and
     .sequence == $saved[0].sequence and .elapsedMilliseconds == $saved[0].elapsedMilliseconds and
     .buildSha == $saved[0].buildSha and .camera == $saved[0].camera' "$manifest" >/dev/null \
    || fail "Agent manifest does not match the saved checkpoint state: $manifest"
  jq -se --slurpfile saved "$state" --arg state "$state" --arg manifest "$manifest" \
    '[.[] | select(.action == "capture")] as $captures |
     ($captures | length) == 1 and $captures[0].accepted == true and
     $captures[0].checkpointStatePath == $state and $captures[0].frameManifestPath == $manifest and
     $captures[0].state == $saved[0]' "$output" >/dev/null \
    || fail "Agent capture response does not match the saved checkpoint state and manifest: $output"
}

agent_checkpoint_self_test() {
  local fixture_dir state manifest output result hash
  fixture_dir="$(mktemp -d)"
  state="$fixture_dir/checkpoint-state.json"
  manifest="$fixture_dir/checkpoint-frame.json"
  output="$fixture_dir/responses.jsonl"
  result="$fixture_dir/result.json"
  hash="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  jq -n --arg hash "$hash" '{schemaVersion: 1, buildSha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    sequence: 7, elapsedMilliseconds: 42, supplies: 100, stateHash: $hash,
    camera: {position: {x: 0, y: 19, z: -18}, rotationEuler: {x: 48, y: 0, z: 0}, fieldOfView: 60}}' \
    > "$state"
  jq -n --arg state "$state" --arg hash "$hash" '{schemaVersion: 1,
    buildSha: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", checkpoint: "fixture", sequence: 7,
    elapsedMilliseconds: 42, statePath: $state, stateHash: $hash,
    camera: {position: {x: 0, y: 19, z: -18}, rotationEuler: {x: 48, y: 0, z: 0}, fieldOfView: 60}}' \
    > "$manifest"
  jq -cn --slurpfile state "$state" --arg state_path "$state" --arg manifest "$manifest" \
    '{action: "capture", accepted: true, checkpointStatePath: $state_path,
      frameManifestPath: $manifest, state: $state[0]}' > "$output"
  jq -n --arg manifest "$manifest" '{checkpointManifests: [$manifest]}' > "$result"
  validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state"
  jq '.supplies = 101' "$state" > "$fixture_dir/corrupt-state.json"
  mv "$fixture_dir/corrupt-state.json" "$state"
  if (validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state") \
      >"$fixture_dir/corrupt-result.log" 2>&1; then
    fail "Corrupted agent checkpoint state unexpectedly passed"
  fi
  grep -F 'capture response does not match' "$fixture_dir/corrupt-result.log" >/dev/null \
    || fail "Corrupted checkpoint fixture did not report the expected cross-file mismatch"
  rm -rf "$fixture_dir"
}

assert_arm64_development_build() {
  local executable="$BUILD_APP/Contents/MacOS/Ashes of Rum"
  local architecture
  [[ -x "$executable" ]] || fail "Built player missing at $BUILD_APP"
  architecture="$(file "$executable")"
  [[ "$architecture" == *"arm64"* && "$architecture" != *"x86_64"* ]] \
    || fail "Expected ARM64-only executable, got: $architecture"
  grep -F 'BUILD_COMPLETE:' "$EVIDENCE/build.log" | grep -F ':Development:ARM64' >/dev/null \
    || fail "Build log does not confirm Development ARM64 configuration"
}

assert_unused_player_modules() {
  local managed="$BUILD_APP/Contents/Resources/Data/Managed"
  local features="$ROOT/Library/Bee/artifacts/MacStandalonePlayerBuildProgram/Features"
  local pattern
  for pattern in \
    'UnityEngine.ClothModule.*' \
    'UnityEngine.MultiplayerModule.*' \
    'UnityEngine.UnityWebRequestAssetBundleModule.*' \
    'UnityEngine.UnityWebRequestAudioModule.*' \
    'UnityEngine.UnityWebRequestTextureModule.*' \
    'UnityEngine.UnityWebRequestWWWModule.*' \
    'UnityEngine.VehiclesModule.*'; do
    if compgen -G "$managed/$pattern" >/dev/null; then
      fail "Unused runtime assembly remains in player: $pattern"
    fi
  done

  # Unity retains a few empty reference assemblies even after their built-in
  # packages are removed. Prove that the player linker found no used features.
  for pattern in Director Tilemap UnityAnalyticsCommon UnityAnalytics UnityWebRequest Video XR; do
    [[ -f "$features/UnityEngine.${pattern}Module-FeaturesChecked.txt" ]] \
      || fail "Missing linker feature report for UnityEngine.${pattern}Module"
    [[ ! -s "$features/UnityEngine.${pattern}Module-FeaturesChecked.txt" ]] \
      || fail "Unused UnityEngine.${pattern}Module has linked player features"
  done
}

wait_for_player() {
  local pid="$1"
  local label="$2"
  local timeout_seconds="${3:-$PLAYER_TIMEOUT_SECONDS}"
  local waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if (( waited >= timeout_seconds )); then
      kill "$pid" 2>/dev/null || true
      sleep 2
      kill -9 "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      fail "$label timed out after $timeout_seconds seconds"
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid" || fail "$label exited with a failure status"
}

smoke() {
  [[ -x "$BUILD_APP/Contents/MacOS/Ashes of Rum" ]] || fail "Built player missing at $BUILD_APP"
  mkdir -p "$EVIDENCE"
  : > "$PLAYER_LOG"
  "$BUILD_APP/Contents/MacOS/Ashes of Rum" \
    -batchmode -nographics -logFile "$PLAYER_LOG" \
    --smoke-test --smoke-output "$SMOKE_RESULT" &
  local pid=$!
  wait_for_player "$pid" "Built-player smoke"
  validate_json "$SMOKE_RESULT"
  jq -e '.passed == true and (.checks | index("Development player running")) != null and
    (.checks | index("Shipped Quit button invokes process exit")) != null' "$SMOKE_RESULT" >/dev/null \
    || fail "Smoke result did not pass development-player checks"
  grep -F 'SMOKE_TEST:PASS' "$PLAYER_LOG" >/dev/null || fail "Smoke pass marker missing from player log"
  grep -F 'SMOKE_TEST:QUIT_BUTTON_INVOKED' "$PLAYER_LOG" >/dev/null \
    || fail "Smoke did not dispatch the shipped Quit button"
  grep -F 'MATCH_QUIT:REQUESTED' "$PLAYER_LOG" >/dev/null \
    || fail "Smoke did not reach the shipped Quit listener"
  scan_log "$PLAYER_LOG"
  say "Built-player smoke passed."
}

graphical_smoke() {
  [[ -x "$BUILD_APP/Contents/MacOS/Ashes of Rum" ]] || fail "Built player missing at $BUILD_APP"
  rm -f "$GRAPHICAL_RESULT" "$GRAPHICAL_LOG" "$GRAPHICAL_SCREENSHOT" "$GRAPHICAL_HEALTH_SCREENSHOT"
  "$BUILD_APP/Contents/MacOS/Ashes of Rum" \
    -screen-width 1920 -screen-height 1080 -screen-fullscreen 0 \
    -logFile "$GRAPHICAL_LOG" --smoke-test \
    --smoke-output "$GRAPHICAL_RESULT" --smoke-screenshot "$GRAPHICAL_SCREENSHOT" \
    --smoke-health-screenshot "$GRAPHICAL_HEALTH_SCREENSHOT" &
  local pid=$!
  wait_for_player "$pid" "Graphical smoke" "$GRAPHICAL_PLAYER_TIMEOUT_SECONDS"
  validate_json "$GRAPHICAL_RESULT"
  jq -e '.passed == true and (.checks | index("Shipped Quit button invokes process exit")) != null and
    (.checks | index("1920x1080 window configured")) != null and
    (.checks | index("Graphical health-bar frame captured")) != null and
    (.checks | index("Graphical frame captured")) != null' "$GRAPHICAL_RESULT" >/dev/null \
    || fail "Graphical smoke result did not pass rendering checks"
  [[ -s "$GRAPHICAL_SCREENSHOT" ]] || fail "Graphical smoke screenshot was not created"
  [[ -s "$GRAPHICAL_HEALTH_SCREENSHOT" ]] || fail "Graphical health-bar screenshot was not created"
  local dimensions
  dimensions="$(sips -g pixelWidth -g pixelHeight "$GRAPHICAL_SCREENSHOT" 2>/dev/null)"
  [[ "$dimensions" == *"pixelWidth: 1920"* && "$dimensions" == *"pixelHeight: 1080"* ]] \
    || fail "Graphical smoke screenshot is not 1920x1080: $dimensions"
  dimensions="$(sips -g pixelWidth -g pixelHeight "$GRAPHICAL_HEALTH_SCREENSHOT" 2>/dev/null)"
  [[ "$dimensions" == *"pixelWidth: 1920"* && "$dimensions" == *"pixelHeight: 1080"* ]] \
    || fail "Graphical health-bar screenshot is not 1920x1080: $dimensions"
  grep -F 'SMOKE_TEST:PASS' "$GRAPHICAL_LOG" >/dev/null || fail "Graphical smoke pass marker missing"
  grep -F 'SMOKE_TEST:QUIT_BUTTON_INVOKED' "$GRAPHICAL_LOG" >/dev/null \
    || fail "Graphical smoke did not dispatch the shipped Quit button"
  grep -F 'MATCH_QUIT:REQUESTED' "$GRAPHICAL_LOG" >/dev/null \
    || fail "Graphical smoke did not reach the shipped Quit listener"
  scan_log "$GRAPHICAL_LOG"
  say "Graphical 1920x1080 smoke passed."
}

validate_agent_screenshot() {
  local manifest="$1"
  local screenshot="$2"
  local graphical="$3"
  if [[ "$graphical" == "true" ]]; then
    [[ -s "$screenshot" ]] || fail "Agent graphical checkpoint was not created: $screenshot"
    local dimensions expected_hash
    dimensions="$(sips -g pixelWidth -g pixelHeight "$screenshot" 2>/dev/null)"
    [[ "$dimensions" == *"pixelWidth: 1920"* && "$dimensions" == *"pixelHeight: 1080"* ]] \
      || fail "Agent checkpoint is not 1920x1080: $dimensions"
    expected_hash="$(shasum -a 256 "$screenshot" | awk '{print $1}')"
    jq -e --arg path "$screenshot" --arg hash "$expected_hash" \
      '.width == 1920 and .height == 1080 and .screenshotPath == $path and
       .screenshotSha256 == $hash' "$manifest" >/dev/null \
      || fail "Agent screenshot manifest does not match the captured PNG"
  else
    jq -e '.width == 0 and .height == 0 and .screenshotPath == "" and .screenshotSha256 == ""' \
      "$manifest" >/dev/null || fail "Headless agent manifest unexpectedly claims a rendered frame"
  fi
}

validate_agent_session() {
  local directory="$1"
  local result="$2"
  local graphical="$3"
  local output="$directory/responses.jsonl"
  local manifest="$directory/gather-deposit-frame.json"
  local state="$directory/gather-deposit-state.json"
  validate_json "$result"
  jq -e --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and .passed == true and
    .scenario == "starting-economy-gather-deposit" and .completedSteps == 8 and
    (.checkpointManifests | length) == 1' "$result" >/dev/null \
    || fail "Agent session result contract failed: $result"
  [[ -s "$output" ]] || fail "Agent response trace missing: $output"
  jq -se --arg sha "$SHA" 'length == 8 and all(.[]; .schemaVersion == 1 and .accepted == true and
    .state.buildSha == $sha and
    .state.perspective == "player" and (.state.workers | length) == 4 and
    (.state.stateHash | length) == 64) and
    .[0].state.supplies == .[0].state.startingSupplies and
    .[5].state.supplies > .[5].state.startingSupplies and
    .[1].state.workers[0].selected == true and
    .[4].state.workers[0].targetCacheId == "cache-1"' "$output" >/dev/null \
    || fail "Agent response trace contract failed: $output"
  validate_json "$manifest"
  validate_json "$state"
  jq -e --arg state "$state" --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and
    .checkpoint == "gather-deposit" and .statePath == $state and (.stateHash | length) == 64' \
    "$manifest" >/dev/null \
    || fail "Agent checkpoint manifest contract failed: $manifest"
  validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state"
  validate_agent_screenshot "$manifest" "$AGENT_GRAPHICAL_SCREENSHOT" "$graphical"
}

validate_house_agent_session() {
  local directory="$1"
  local result="$2"
  local graphical="$3"
  local output="$directory/responses.jsonl"
  local manifest="$directory/house-complete-frame.json"
  local state="$directory/house-complete-state.json"
  validate_json "$result"
  jq -e --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and .passed == true and
    .scenario == "house-construction-completion" and .completedSteps == 6 and
    (.checkpointManifests | length) == 1' "$result" >/dev/null \
    || fail "House agent session result contract failed: $result"
  [[ -s "$output" ]] || fail "House agent response trace missing: $output"
  jq -se --arg sha "$SHA" 'length == 6 and all(.[]; .schemaVersion == 1 and .accepted == true and
    .state.buildSha == $sha and .state.perspective == "player" and
    (.state.workers | length) == 4 and (.state.stateHash | length) == 64) and
    .[0].state.supplies == .[0].state.startingSupplies and .[0].state.populationCapacity == 12 and
    (.[0].state.buildings | length) == 0 and .[1].state.workers[0].selected == true and
    .[2].state.supplies == 0 and .[2].state.populationCapacity == 12 and
    .[2].state.buildings == [{id:"building-1", type:"House", selected:false, complete:false, health:100,
      maxHealth:100, progress:0, assignedBuilderIds:["worker-1"], position:{x:8,y:0,z:-1}}] and
    .[3].state.populationCapacity == 20 and .[3].state.buildings[0].complete == true and
    .[3].state.buildings[0].progress == 1 and .[4].state.supplies == 0 and
    .[4].state.populationCapacity == 20 and .[4].state.buildings[0].complete == true and
    .[4].state.buildings[0].progress == 1' "$output" >/dev/null \
    || fail "House agent response trace contract failed: $output"
  validate_json "$manifest"
  validate_json "$state"
  jq -e --arg state "$state" --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and
    .checkpoint == "house-complete" and .statePath == $state and (.stateHash | length) == 64' \
    "$manifest" >/dev/null \
    || fail "House agent checkpoint manifest contract failed: $manifest"
  validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state"
  validate_agent_screenshot "$manifest" "$HOUSE_AGENT_GRAPHICAL_SCREENSHOT" "$graphical"
}

validate_training_agent_session() {
  local directory="$1"
  local result="$2"
  local graphical="$3"
  local output="$directory/responses.jsonl"
  local manifest="$directory/spearmen-ready-frame.json"
  local state="$directory/spearmen-ready-state.json"
  validate_json "$result"
  jq -e --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and .passed == true and
    .scenario == "spearmen-training-completion" and .completedSteps == 11 and
    (.checkpointManifests | length) == 1' "$result" >/dev/null \
    || fail "Training agent session result contract failed: $result"
  [[ -s "$output" ]] || fail "Training agent response trace missing: $output"
  jq -se --arg sha "$SHA" 'length == 11 and all(.[]; .schemaVersion == 1 and .accepted == true and
    .state.buildSha == $sha and .state.perspective == "player" and
    (.state.workers | length) == 4 and (.state.formations | type) == "array" and
    (.state.production | type) == "object" and (.state.stateHash | length) == 64) and
    .[0].state.supplies == .[0].state.startingSupplies and .[0].state.populationUsed == 4 and
    .[0].state.populationCapacity == 12 and .[0].state.production.count == 0 and
    (.[0].state.formations | length) == 0 and
    all(.[1].state.workers[]; .selected == true) and
    all(.[2].state.workers[]; .targetCacheId == "cache-1") and
    .[3].state.supplies >= 400 and .[5].state.supplies >= 400 and .[6].state.hisar.selected == true and
    (.[6].state.supplies - .[7].state.supplies) == 400 and
    .[7].state.populationUsed == 12 and .[7].state.production.count == 1 and
    .[7].state.production.activeItem == "Spearmen" and .[7].state.production.progress == 0 and
    (.[7].state.formations | length) == 0 and
    .[8].state.production.count == 0 and (.[8].state.formations | length) == 1 and
    .[8].state.formations[0].id == "formation-1" and
    .[8].state.formations[0].type == "Spearmen" and
    .[8].state.formations[0].selected == false and
    .[8].state.formations[0].memberCount == 8 and
    .[8].state.formations[0].totalHealth == 160 and
    .[8].state.formations[0].maxHealth == 160 and
    .[8].state.formations[0].order == "Idle" and
    .[8].state.formations[0].hasDestination == false and
    .[8].state.formations[0].position.x == -5 and
    .[8].state.formations[0].position.y > 0.08 and .[8].state.formations[0].position.y < 0.09 and
    .[8].state.formations[0].position.z == -1 and
    .[9].state.production.count == 0 and .[9].state.formations == .[8].state.formations' \
    "$output" >/dev/null || fail "Training agent response trace contract failed: $output"
  validate_json "$manifest"
  validate_json "$state"
  jq -e --arg state "$state" --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and
    .checkpoint == "spearmen-ready" and .statePath == $state and (.stateHash | length) == 64' \
    "$manifest" >/dev/null || fail "Training agent checkpoint manifest contract failed: $manifest"
  validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state"
  validate_agent_screenshot "$manifest" "$TRAINING_AGENT_GRAPHICAL_SCREENSHOT" "$graphical"
}

validate_movement_agent_session() {
  local directory="$1"
  local result="$2"
  local graphical="$3"
  local output="$directory/responses.jsonl"
  local manifest="$directory/spearmen-moved-frame.json"
  local state="$directory/spearmen-moved-state.json"
  validate_json "$result"
  jq -e --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and .passed == true and
    .scenario == "spearmen-movement-arrival" and .completedSteps == 14 and
    (.checkpointManifests | length) == 1' "$result" >/dev/null \
    || fail "Movement agent session result contract failed: $result"
  [[ -s "$output" ]] || fail "Movement agent response trace missing: $output"
  jq -se --arg sha "$SHA" 'length == 14 and all(.[]; .schemaVersion == 1 and .accepted == true and
    .state.buildSha == $sha and .state.perspective == "player" and
    (.state.workers | length) == 4 and (.state.formations | type) == "array" and
    (.state.stateHash | length) == 64) and
    .[3].state.supplies >= 400 and .[6].state.hisar.selected == true and
    (.[6].state.supplies - .[7].state.supplies) == 400 and
    .[8].state.formations[0].id == "formation-1" and
    .[8].state.formations[0].type == "Spearmen" and .[8].state.formations[0].selected == false and
    .[9].state.formations[0].id == "formation-1" and .[9].state.formations[0].selected == true and
    .[10].state.formations[0].order == "Move" and .[10].state.formations[0].hasDestination == true and
    .[10].state.formations[0].destination.x == 4 and .[10].state.formations[0].destination.z == 5 and
    .[11].state.formations[0].id == "formation-1" and .[11].state.formations[0].selected == true and
    .[11].state.formations[0].order == "Idle" and .[11].state.formations[0].hasDestination == false and
    ((.[11].state.formations[0].position.x - 4) | fabs) <= 0.5 and
    ((.[11].state.formations[0].position.z - 5) | fabs) <= 0.5 and
    .[12].state.formations == .[11].state.formations' "$output" >/dev/null \
    || fail "Movement agent response trace contract failed: $output"
  validate_json "$manifest"
  validate_json "$state"
  jq -e --arg state "$state" --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and
    .checkpoint == "spearmen-moved" and .statePath == $state and (.stateHash | length) == 64' \
    "$manifest" >/dev/null || fail "Movement agent checkpoint manifest contract failed: $manifest"
  validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state"
  validate_agent_screenshot "$manifest" "$MOVEMENT_AGENT_GRAPHICAL_SCREENSHOT" "$graphical"
}

validate_combat_agent_session() {
  local directory="$1"
  local result="$2"
  local graphical="$3"
  local output="$directory/responses.jsonl"
  local manifest="$directory/spearmen-focus-worker-frame.json"
  local state="$directory/spearmen-focus-worker-state.json"
  validate_json "$result"
  jq -e --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and .passed == true and
    .scenario == "spearmen-scout-and-focus-combat" and .completedSteps == 21 and
    (.checkpointManifests | length) == 1' "$result" >/dev/null \
    || fail "Combat agent session result contract failed: $result"
  [[ -s "$output" ]] || fail "Combat agent response trace missing: $output"
  jq -se --arg sha "$SHA" 'length == 21 and all(.[]; .schemaVersion == 1 and .accepted == true and
    .state.buildSha == $sha and .state.perspective == "player" and
    (.state.visibleHostileFormations | type) == "array" and
    (.state.visibleHostileWorkers | type) == "array" and
    (.state.visibleHostileStructures | type) == "array" and (.state.stateHash | length) == 64) and
    (.[0].state.visibleHostileFormations | length) == 0 and
    (.[0].state.visibleHostileWorkers | length) == 0 and
    (.[0].state.visibleHostileStructures | length) == 0 and
    .[6].state.hisar.selected == true and
    .[9].state.formations[0].id == "formation-1" and .[9].state.formations[0].selected == true and
    .[10].state.formations[0].order == "AttackMove" and .[10].state.formations[0].hasDestination == true and
    .[11].state.formations[0].order == "Idle" and .[11].state.formations[0].hasDestination == false and
    (.[13].state.visibleHostileWorkers | length) > 0 and
    .[14].state.formations[0].order == "Idle" and
    .[15].state.formations[0].order == "Move" and
    .[16].requestId == "wait-for-worker-in-focus-range" and
    any(.[16].state.visibleHostileWorkers[]; .id == "hostile-worker-1" and .activity == "Gathering") and
    .[17].state.formations[0].order == "Focus" and .[17].state.formations[0].targetId == "hostile-worker-1" and
    any(.[17].state.visibleHostileWorkers[]; .id == "hostile-worker-1") and
    .[18].state.formations[0].selected == true and
    .[18].state.formations[0].order == "Focus" and
    .[18].state.formations[0].targetId == "hostile-worker-1" and
    any(.[18].state.visibleHostileWorkers[]; .id == "hostile-worker-1") and
    .[19].requestId == "wait-for-focus-damage" and
    .[19].state.formations[0].targetId == "" and
    all(.[19].state.visibleHostileWorkers[]; .id != "hostile-worker-1")' \
    "$output" >/dev/null || fail "Combat agent response trace contract failed: $output"
  validate_json "$manifest"
  validate_json "$state"
  jq -e --arg state "$state" --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and
    .checkpoint == "spearmen-focus-worker" and .statePath == $state and (.stateHash | length) == 64' \
    "$manifest" >/dev/null || fail "Combat agent checkpoint manifest contract failed: $manifest"
  validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state"
  validate_agent_screenshot "$manifest" "$COMBAT_AGENT_GRAPHICAL_SCREENSHOT" "$graphical"
}

validate_economy_agent_session() {
  local directory="$1"
  local result="$2"
  local graphical="$3"
  local output="$directory/responses.jsonl"
  local manifest="$directory/economy-production-complete-frame.json"
  local state="$directory/economy-production-complete-state.json"
  validate_json "$result"
  jq -e --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and .passed == true and
    .scenario == "economy-production-cancellation-rally-demolition" and .completedSteps == 30 and
    (.checkpointManifests | length) == 1' "$result" >/dev/null \
    || fail "Economy agent session result contract failed: $result"
  [[ -s "$output" ]] || fail "Economy agent response trace missing: $output"
  jq -se --arg sha "$SHA" 'length == 30 and all(.[]; .schemaVersion == 1 and .accepted == true and
    .state.buildSha == $sha and .state.perspective == "player" and
    .state.hisar.id == "hisar" and .state.hisar.health == .state.hisar.maxHealth and
    (.state.production.count | type) == "number" and (.state.production.progress | type) == "number" and
    (.state.stateHash | length) == 64) and
    .[0].state.hisar.selected == false and .[0].state.hisar.hasRally == false and
    .[7].state.supplies == 0 and .[7].state.buildings[0].id == "building-1" and
    .[7].state.buildings[0].type == "Storehouse" and .[7].state.buildings[0].complete == false and
    .[8].state.supplies == 200 and .[8].state.buildings == [] and
    .[10].state.supplies == 0 and .[10].state.buildings[0].id == "building-2" and
    .[11].state.buildings[0].complete == true and .[11].state.buildings[0].progress == 1 and
    all(.[16].state.workers[]; .activity == "Idle" and .carriedSupplies == 0) and
    .[17].state.hisar.selected == true and
    .[18].state.hisar.hasRally == true and .[18].state.hisar.rallyCacheId == "cache-2" and
    .[19].state.production.count == 1 and .[19].state.production.activeItem == "Worker" and
    .[19].state.supplies == (.[18].state.supplies - 100) and
    .[20].state.production.count == 0 and .[20].state.supplies == .[18].state.supplies and
    .[21].state.production.count == 1 and .[21].state.production.activeItem == "Worker" and
    .[21].state.supplies == (.[20].state.supplies - 100) and
    .[22].state.production.count == 0 and (.[22].state.workers | length) == 5 and
    .[23].state.workers[4].id == "worker-5" and .[23].state.workers[4].targetCacheId == "cache-2" and
    (.[23].state.workers[4].activity == "GoingToCache" or
     .[23].state.workers[4].activity == "Gathering" or .[23].state.workers[4].activity == "Returning") and
    .[24].requestId == "select-storehouse-for-demolition" and
    .[24].state.buildings[0].id == "building-2" and .[24].state.buildings[0].selected == true and
    .[25].state.buildings[0].id == "building-2" and .[25].state.buildings[0].selected == true and
    .[26].state.buildings == [] and .[26].state.supplies == .[25].state.supplies and
    .[28].state.buildings == [] and (.[28].state.workers | length) == 5 and
    .[28].state.hisar.hasRally == true and .[28].state.hisar.rallyCacheId == "" and
    .[28].state.hisar.rallyPosition.x == 8 and .[28].state.hisar.rallyPosition.z == 6 and
    .[28].state.production.count == 0' "$output" >/dev/null \
    || fail "Economy agent response trace contract failed: $output"
  validate_json "$manifest"
  validate_json "$state"
  jq -e --arg state "$state" --arg sha "$SHA" '.schemaVersion == 1 and .buildSha == $sha and
    .checkpoint == "economy-production-complete" and .statePath == $state and
    (.stateHash | length) == 64' "$manifest" >/dev/null \
    || fail "Economy agent checkpoint manifest contract failed: $manifest"
  validate_agent_checkpoint_contract "$result" "$output" "$manifest" "$state"
  validate_agent_screenshot "$manifest" "$ECONOMY_AGENT_GRAPHICAL_SCREENSHOT" "$graphical"
}

agent_smoke() {
  [[ -x "$BUILD_APP/Contents/MacOS/Ashes of Rum" ]] || fail "Built player missing at $BUILD_APP"
  rm -rf "$AGENT_HEADLESS_DIR"
  mkdir -p "$AGENT_HEADLESS_DIR"
  "$BUILD_APP/Contents/MacOS/Ashes of Rum" -batchmode -nographics \
    -logFile "$AGENT_HEADLESS_DIR/player.log" \
    --agent-script "$AGENT_SCRIPT" \
    --agent-output "$AGENT_HEADLESS_DIR/responses.jsonl" \
    --agent-result "$AGENT_HEADLESS_RESULT" \
    --agent-artifacts "$AGENT_HEADLESS_DIR" \
    --agent-build-sha "$SHA" &
  local pid=$!
  wait_for_player "$pid" "Headless agent session"
  validate_agent_session "$AGENT_HEADLESS_DIR" "$AGENT_HEADLESS_RESULT" false
  grep -F 'AGENT_SESSION:PASS' "$AGENT_HEADLESS_DIR/player.log" >/dev/null \
    || fail "Headless agent pass marker missing"
  scan_log "$AGENT_HEADLESS_DIR/player.log"
  say "Headless code-playable starting economy passed."
}

agent_graphical_smoke() {
  [[ -x "$BUILD_APP/Contents/MacOS/Ashes of Rum" ]] || fail "Built player missing at $BUILD_APP"
  rm -rf "$AGENT_GRAPHICAL_DIR"
  mkdir -p "$AGENT_GRAPHICAL_DIR"
  "$BUILD_APP/Contents/MacOS/Ashes of Rum" \
    -screen-width 1920 -screen-height 1080 -screen-fullscreen 0 \
    -logFile "$AGENT_GRAPHICAL_DIR/player.log" \
    --agent-script "$AGENT_SCRIPT" \
    --agent-output "$AGENT_GRAPHICAL_DIR/responses.jsonl" \
    --agent-result "$AGENT_GRAPHICAL_RESULT" \
    --agent-artifacts "$AGENT_GRAPHICAL_DIR" \
    --agent-build-sha "$SHA" \
    --agent-screenshot "$AGENT_GRAPHICAL_SCREENSHOT" &
  local pid=$!
  wait_for_player "$pid" "Graphical agent session" "$GRAPHICAL_PLAYER_TIMEOUT_SECONDS"
  validate_agent_session "$AGENT_GRAPHICAL_DIR" "$AGENT_GRAPHICAL_RESULT" true
  grep -F 'AGENT_SESSION:PASS' "$AGENT_GRAPHICAL_DIR/player.log" >/dev/null \
    || fail "Graphical agent pass marker missing"
  scan_log "$AGENT_GRAPHICAL_DIR/player.log"
  say "Graphical code-playable starting economy passed."
}

