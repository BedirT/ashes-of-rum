{
  "schemaVersion": 1,
  "scenario": "spearmen-training-completion",
  "steps": [
    {
      "id": "observe-initial",
      "action": "observe"
    },
    {
      "id": "select-gatherers",
      "action": "select",
      "actorIds": ["worker-1", "worker-2", "worker-3", "worker-4"]
    },
    {
      "id": "gather-formation-cost",
      "action": "gather",
      "targetId": "cache-1"
    },
    {
      "id": "wait-for-formation-cost",
      "action": "wait",
      "condition": "supplies_greater_than",
      "value": 399,
      "timeoutSeconds": 75
    },
    {
      "id": "stop-gathering",
      "action": "move",
      "x": 0.0,
      "z": -2.0
    },
    {
      "id": "wait-for-idle-worker",
      "action": "wait",
      "condition": "worker_idle",
      "targetId": "worker-1",
      "timeoutSeconds": 20
    },
    {
      "id": "select-hisar",
      "action": "select_hisar"
    },
    {
      "id": "train-spearmen",
      "action": "train",
      "formationType": "Spearmen"
    },
    {
      "id": "wait-for-spearmen",
      "action": "wait",
      "condition": "formation_ready",
      "formationType": "Spearmen",
      "timeoutSeconds": 20
    },
    {
      "id": "capture-spearmen",
      "action": "capture",
      "checkpoint": "spearmen-ready"
    },
    {
      "id": "quit-session",
      "action": "quit"
    }
  ]
}
