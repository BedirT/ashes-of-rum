{
  "schemaVersion": 1,
  "scenario": "complete-match-victory-restart",
  "steps": [
    { "id": "observe-launch", "action": "observe" },
    { "id": "select-house-builder", "action": "select", "actorIds": ["worker-1"] },
    { "id": "build-required-house", "action": "build", "buildingType": "House", "x": 8, "z": -1 },
    { "id": "wait-required-house", "action": "wait", "condition": "building_complete", "targetId": "building-1", "timeoutSeconds": 20 },
    { "id": "select-real-gatherers", "action": "select", "actorIds": ["worker-1", "worker-2", "worker-3", "worker-4"] },
    { "id": "gather-east-safe-cache", "action": "gather", "targetId": "cache-2" },
    { "id": "wait-east-safe-cache", "action": "wait", "condition": "supplies_greater_than", "value": 399, "timeoutSeconds": 90 },
    { "id": "move-to-reveal-west-cache", "action": "move", "x": 0, "z": 3 },
    { "id": "wait-between-safe-caches", "action": "wait", "condition": "cache_visible", "targetId": "cache-1", "timeoutSeconds": 30 },
    { "id": "gather-west-safe-cache", "action": "gather", "targetId": "cache-1" },
    { "id": "wait-real-formation-economy", "action": "wait", "condition": "supplies_greater_than", "value": 799, "timeoutSeconds": 90 },
    { "id": "select-production-hisar", "action": "select_hisar" },
    { "id": "train-counter-spearmen", "action": "train", "formationType": "Spearmen" },
    { "id": "train-counter-archers", "action": "train", "formationType": "Archers" },
    { "id": "wait-spearmen", "action": "wait", "condition": "formation_ready", "formationType": "Spearmen", "timeoutSeconds": 20 },
    { "id": "wait-archers", "action": "wait", "condition": "formation_ready", "formationType": "Archers", "timeoutSeconds": 20 },
    { "id": "select-assault", "action": "select", "actorIds": ["formation-1", "formation-2"] },
    { "id": "center-assault", "action": "center_camera", "targetId": "formation-1" },
    { "id": "capture-assault", "action": "capture", "checkpoint": "complete-match-assault" },
    { "id": "scout-hostile-hisar", "action": "attack_move", "x": 0, "z": 22 },
    { "id": "wait-hostile-hisar", "action": "wait", "condition": "hostile_structure_visible", "targetId": "enemy-hisar", "timeoutSeconds": 90 },
    { "id": "center-hostile-hisar", "action": "center_camera", "targetId": "enemy-hisar" },
    { "id": "focus-hostile-hisar", "action": "focus", "targetId": "enemy-hisar" },
    { "id": "wait-victory", "action": "wait", "condition": "outcome_is", "targetId": "Victory", "timeoutSeconds": 120 },
    { "id": "capture-victory", "action": "capture", "checkpoint": "complete-match-victory" },
    { "id": "restart-shipped-match", "action": "restart" },
    { "id": "capture-fresh-match", "action": "capture", "checkpoint": "complete-match-restarted" },
    { "id": "end-restart-session", "action": "end_session" }
  ]
}
