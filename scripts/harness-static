#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

validate_csharp_line_count() {
  local source="$1"
  local lines
  lines="$(awk 'END { print NR }' "$source")"
  if (( lines > 1000 )); then
    printf 'Hand-authored C# file exceeds 1,000 lines: %s (%s)\n' "$source" "$lines" >&2
    return 1
  fi
}

bash -n scripts/harness scripts/harness-static scripts/agent-live-client
git diff --check

branch="$(git branch --show-current)"
if [[ "$branch" != "main" ]]; then
  base_ref="${HARNESS_BASE_REF:-main}"
  merge_base="$(git merge-base "$base_ref" HEAD)"
  git diff --check "$merge_base..HEAD"
fi

for forbidden in Library Temp Obj Logs Builds UserSettings .artifacts; do
  if git ls-files "$forbidden" "$forbidden/**" | grep -q .; then
    printf 'Generated directory is tracked: %s\n' "$forbidden" >&2
    exit 1
  fi
done

missing=0
while IFS= read -r asset; do
  [[ "$asset" == *.meta ]] && continue
  if [[ ! -f "$asset.meta" ]]; then
    printf 'Missing Unity meta file: %s.meta\n' "$asset" >&2
    missing=1
  fi
done < <(git ls-files Assets)
(( missing == 0 )) || exit 1

while IFS= read -r directory; do
  [[ "$directory" == "Assets" ]] && continue
  if [[ ! -f "$directory.meta" ]]; then
    printf 'Missing Unity folder meta file: %s.meta\n' "$directory" >&2
    missing=1
  fi
done < <(git ls-files Assets | awk -F/ 'NF > 1 {path=$1; for (i=2; i<NF; i++) {path=path "/" $i; print path}}' | sort -u)
(( missing == 0 )) || exit 1

while IFS= read -r source; do
  validate_csharp_line_count "$source"
done < <(git ls-files --cached --others --exclude-standard -- 'Assets/*.cs' 'Assets/**/*.cs')

grep -F 'm_EditorVersion: 6000.5.5f1' ProjectSettings/ProjectVersion.txt >/dev/null
grep -F 'Assets/Scenes/Bootstrap.unity' ProjectSettings/EditorBuildSettings.asset >/dev/null
grep -F 'defaultScreenWidth: 1920' ProjectSettings/ProjectSettings.asset >/dev/null
grep -F 'defaultScreenHeight: 1080' ProjectSettings/ProjectSettings.asset >/dev/null
grep -A1 'platformArchitecture:' ProjectSettings/ProjectSettings.asset | grep -F 'Standalone: 1' >/dev/null
grep -F 'UnityEditor.OSXStandalone.UserBuildSettings.architecture = OSArchitecture.ARM64' Assets/Editor/MacPlayerBuilder.cs >/dev/null
grep -F 'BuildOptions.CleanBuildCache | BuildOptions.Development' Assets/Editor/MacPlayerBuilder.cs >/dev/null
grep -F 'PlayerSettings.SetManagedStrippingLevel(NamedBuildTarget.Standalone, ManagedStrippingLevel.High)' Assets/Editor/MacPlayerBuilder.cs >/dev/null
jq -e '.dependencies | keys | sort == [
  "com.unity.ai.navigation",
  "com.unity.inputsystem",
  "com.unity.modules.screencapture",
  "com.unity.render-pipelines.universal",
  "com.unity.test-framework",
  "com.unity.ugui"
]' Packages/manifest.json >/dev/null
jq -e '[.dependencies | to_entries[] | select(.value.depth == 0) | .key] | sort == [
  "com.unity.ai.navigation",
  "com.unity.inputsystem",
  "com.unity.modules.screencapture",
  "com.unity.render-pipelines.universal",
  "com.unity.test-framework",
  "com.unity.ugui"
]' Packages/packages-lock.json >/dev/null
jq -e '[.dependencies | keys[] | select(startswith("com.unity.modules."))] | sort == [
  "com.unity.modules.ai",
  "com.unity.modules.animation",
  "com.unity.modules.audio",
  "com.unity.modules.hierarchycore",
  "com.unity.modules.imageconversion",
  "com.unity.modules.imgui",
  "com.unity.modules.jsonserialize",
  "com.unity.modules.physics",
  "com.unity.modules.physics2d",
  "com.unity.modules.physicscore2d",
  "com.unity.modules.screencapture",
  "com.unity.modules.terrain",
  "com.unity.modules.ui",
  "com.unity.modules.uielements"
]' Packages/packages-lock.json >/dev/null

review_fixture="$(printf '%s\n' \
  '[{"body":"reviewed-head: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\nreview-round: 1\nblocking-findings: 3","submitted_at":"2026-07-25T01:00:00Z"}]' \
  '[{"body":"unrelated reviewed-head: bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},{"body":"reviewed-head: cccccccccccccccccccccccccccccccccccccccc\nreview-round: 2\nblocking-findings: 0","created_at":"2026-07-25T02:00:00Z"}]' \
  | jq -sf scripts/review-state.jq)"
[[ "$(jq -r '.head' <<<"$review_fixture")" == "cccccccccccccccccccccccccccccccccccccccc" ]]
[[ "$(jq -r '.round' <<<"$review_fixture")" == "2" ]]
[[ "$(jq -r '.blockers' <<<"$review_fixture")" == "0" ]]

contract_tmp="$(mktemp -d)"
trap 'rm -rf "$contract_tmp"' EXIT
awk 'BEGIN { for (i = 1; i <= 1000; i++) printf "line %d%s", i, (i < 1000 ? ORS : "") }' \
  > "$contract_tmp/at-limit.cs"
awk 'BEGIN { for (i = 1; i <= 1001; i++) printf "line %d%s", i, (i < 1001 ? ORS : "") }' \
  > "$contract_tmp/over-limit.cs"
validate_csharp_line_count "$contract_tmp/at-limit.cs"
if validate_csharp_line_count "$contract_tmp/over-limit.cs" >"$contract_tmp/line-count.log" 2>&1; then
  printf 'C# line-count fixture above 1,000 lines unexpectedly passed\n' >&2
  exit 1
fi
grep -F 'over-limit.cs (1001)' "$contract_tmp/line-count.log" >/dev/null
cat > "$contract_tmp/unity" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "${UNITY_NO_CONSENT_PROMPT:-}" == "1" ]]
[[ "${UNITY_NO_UPDATE_CHECK:-}" == "1" ]]
[[ "${1:-}" == "--no-banner" ]]
[[ "${2:-}" == "--non-interactive" ]]
printf '%s\n' "$*" >> "$HARNESS_CLI_CALLS"
if [[ "$*" == *"editors list --installed"* ]]; then
  printf '6000.5.5f1\n'
fi
EOF
cat > "$contract_tmp/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "pr" && "${2:-}" == "view" ]]; then
  printf '{"number":2,"headRefOid":"%s"}\n' "${HARNESS_PR_HEAD:-missing}"
  exit 0
fi
exit 99
EOF
chmod +x "$contract_tmp/unity" "$contract_tmp/gh"
HARNESS_CLI_CALLS="$contract_tmp/calls" \
  UNITY_CLI="$contract_tmp/unity" \
  PATH="$contract_tmp:$PATH" \
  scripts/harness doctor >/dev/null
[[ "$(wc -l < "$contract_tmp/calls" | tr -d ' ')" == "4" ]]
HARNESS_PR_HEAD="$(git rev-parse HEAD)" PATH="$contract_tmp:$PATH" \
  scripts/harness head-freshness-self-test >/dev/null
if HARNESS_PR_HEAD="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" PATH="$contract_tmp:$PATH" \
  scripts/harness head-freshness-self-test >"$contract_tmp/stale-head.log" 2>&1; then
  printf 'Stale PR head fixture unexpectedly passed\n' >&2
  exit 1
fi
grep -F 'does not match local HEAD' "$contract_tmp/stale-head.log" >/dev/null
scripts/harness scan-log-self-test
scripts/harness agent-checkpoint-self-test
if PLAYER_TIMEOUT_SECONDS=1 scripts/harness watchdog-self-test >"$contract_tmp/watchdog.log" 2>&1; then
  printf 'Player watchdog self-test unexpectedly passed\n' >&2
  exit 1
fi
grep -F 'Watchdog self-test timed out after 1 seconds' "$contract_tmp/watchdog.log" >/dev/null
grep -F '## 7. Every Slice Requires A Proper Pull Request' AGENTS.md >/dev/null
grep -F 'reviewed-head:' AGENTS.md >/dev/null

printf '[harness-static] All repository checks passed.\n'
