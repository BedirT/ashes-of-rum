* text=auto
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf
*.png binary
*.jpg binary

# Unity serializes empty YAML values with a trailing space. Keep other whitespace checks active.
*.asset whitespace=-trailing-space
*.unity whitespace=-trailing-space
*.meta whitespace=-trailing-space
*.inputactions whitespace=-trailing-space
*.prefab whitespace=-trailing-space
*.mat whitespace=-trailing-space
*.anim whitespace=-trailing-space
*.controller whitespace=-trailing-space
